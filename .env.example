# ==============================================================
# University Library Management System (LMS) - Environment Config
# ==============================================================

# Database Connection
# --------------------
# 1. Local Development (SQLite zero-dependency fallback):
DATABASE_URL=sqlite:///./library.db

# 2. Supabase PostgreSQL (Recommended for Production & Render):
# In your Supabase Project Dashboard -> Project Settings -> Database -> Connection String:
# Use either Transaction pooler (port 6543) or Session pooler (port 5432) or direct connection:
# DATABASE_URL=postgresql://postgres.your-project-ref:[YOUR-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Security & Authentication
# -------------------------
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Default Administrator Seed Credentials
# --------------------------------------
ADMIN_DEFAULT_USERNAME=admin
ADMIN_DEFAULT_PASSWORD=Admin123!

# Server Host & Port (Optional, defaults to 0.0.0.0 and 8000)
# PORT=8000
